{
  "name": "billetico-api-tests",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:defects": "vitest run --config vitest.defects.config.ts",
    "test:verbose": "vitest run --reporter=verbose",
    "test:report": "vitest run --reporter=default --reporter=html --reporter=junit --outputFile.junit=reports/main/junit.xml",
    "test:defects:report": "vitest run --config vitest.defects.config.ts --reporter=default --reporter=html --reporter=junit --outputFile.junit=reports/defects/junit.xml",
    "report:open": "vite preview --outDir .vitest --open"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@vitest/ui": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
