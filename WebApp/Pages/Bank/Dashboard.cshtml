@page
@model WebApp.Pages.Bank.DashboardModel
@{
    ViewData["Title"] = "Dashboard Banco";
    Layout = "~/Pages/Shared/_BankLayout.cshtml";
}

<div class="container-fluid">
    <!-- Encabezado del banco -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h2 class="mb-0" id="bankName">
                                <i class="fas fa-university me-2"></i>Cargando...
                            </h2>
                            <p class="text-muted mb-0" id="bankEmail">Email del banco</p>
                        </div>
                        <div class="col-md-4 text-end">
                            <span class="badge bg-success fs-6" id="bankStatus">Activo</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Estadísticas de pagos -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center bg-primary text-white">
                <div class="card-body">
                    <i class="fas fa-credit-card fa-2x mb-2"></i>
                    <h4 id="totalProcessed">₡0.00</h4>
                    <p class="mb-0">Total Procesado</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center bg-success text-white">
                <div class="card-body">
                    <i class="fas fa-exchange-alt fa-2x mb-2"></i>
                    <h4 id="totalTransactions">0</h4>
                    <p class="mb-0">Transacciones</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center bg-warning text-white">
                <div class="card-body">
                    <i class="fas fa-money-bill-wave fa-2x mb-2"></i>
                    <h4 id="totalCommissions">₡0.00</h4>
                    <p class="mb-0">Comisiones Pagadas</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filtros -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-filter me-2"></i>Filtros de Búsqueda</h5>
                </div>
                <div class="card-body">
                    <form id="filterForm">
                        <div class="row">
                            <div class="col-md-3">
                                <label for="startDate" class="form-label">Fecha Desde</label>
                                <input type="date" class="form-control" id="startDate" name="startDate">
                            </div>
                            <div class="col-md-3">
                                <label for="endDate" class="form-label">Fecha Hasta</label>
                                <input type="date" class="form-control" id="endDate" name="endDate">
                            </div>
                            <div class="col-md-3">
                                <label for="statusFilter" class="form-label">Estado</label>
                                <select class="form-select" id="statusFilter" name="statusFilter">
                                    <option value="">Todos los estados</option>
                                    <option value="Pagado">Pagado</option>
                                    <option value="Pendiente">Pendiente</option>
                                </select>
                            </div>
                            <div class="col-md-3 d-flex align-items-end">
                                <button type="button" class="btn btn-primary me-2" id="btnApplyFilter">
                                    <i class="fas fa-search me-1"></i>Buscar
                                </button>
                                <button type="button" class="btn btn-secondary" id="btnClearFilter">
                                    <i class="fas fa-times me-1"></i>Limpiar
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla de pagos procesados -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="fas fa-list me-2"></i>Pagos Procesados</h5>
                    <button class="btn btn-outline-primary btn-sm" id="btnRefresh">
                        <i class="fas fa-sync-alt me-1"></i>Actualizar
                    </button>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="paymentsTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>Fecha</th>
                                    <th>Comercio</th>
                                    <th>Descripción</th>
                                    <th>Monto</th>
                                    <th>Comisión Pagada</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody id="paymentsTableBody">
                                <!-- Los datos se cargarán aquí dinámicamente -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Mensaje cuando no hay pagos -->
                    <div id="noPaymentsMessage" class="text-center mt-4 d-none">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>No hay pagos registrados</strong>
                            <p class="mb-0 mt-2">Aún no se han procesado pagos con las cuentas de este banco.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/BankDashboard.js"></script>
}