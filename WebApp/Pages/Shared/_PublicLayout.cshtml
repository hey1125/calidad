<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BilleTico</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

</head>
<body>
    <!-- HEADER personalizado -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm fixed-top">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-page="/Public/Index">
                    <img src="~/img/logo-billetico.png" alt="Logo BilleTico" style="height: 40px;" />
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link fw-bold active" href="#inicio">Inicio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#beneficios">Información</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="#comercios">Afiliados</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-page="/Public/Register">Registrarse</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-success fw-bold" asp-page="/Public/Login">Iniciar Sesión</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- CONTENIDO -->
    <div class="mt-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="custom-footer text-center py-3 border-top">
        <small class="text-muted">
            &copy; 2025 <strong>BilleTico</strong>. Todos los derechos reservados. &nbsp;–&nbsp;
            Desarrollado por el equipo <strong>CodeStream</strong>.
        </small>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>