<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - BilleTico</title>

    <link rel="icon" type="image/x-icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.2/css/dataTables.dataTables.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/3.0.5/css/responsive.dataTables.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <!-- jQuery primero -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- DataTables core -->
    <script src="https://cdn.datatables.net/2.3.2/js/dataTables.min.js"></script>

    <!-- DataTables Responsive plugin -->
    <script src="https://cdn.datatables.net/responsive/3.0.5/js/dataTables.responsive.min.js"></script>

    <!-- Bootstrap JS (después de jQuery y DataTables) -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Tu JS -->
    <script src="~/js/pages/controlactions.js"></script>

    @RenderSection("Styles", required: false)

</head>

<body>

    <div class="d-flex" id="wrapper">
        <!-- SIDEBAR -->

        <button id="sidebarToggle"
                class="btn btn-outline-light d-md-none position-fixed top-0 start-0 m-2 z-3"
                type="button">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="sidebar d-flex flex-column justify-content-between" id="sidebarMenu">
            <div>
                <div class="text-center py-3">
                    <a asp-page="/Public/Index" class="d-block">
                        <img src="~/img/logo-billetico.png" alt="Logo BilleTico" style="height: 40px;" />
                    </a>
                </div>

                @{
                    var route = Context.Request.Path;
                }

                <div class="list-group list-group-flush">
                    <a asp-page="/User/Dashboard" class="list-group-item @(route == "/User/Dashboard" ? "active" : "")">Inicio</a>
                    <a asp-page="/User/UserPayments" class="list-group-item @(route == "/User/UserPayments" ? "active" : "")">Pagos</a>
                    <a asp-page="/User/BankAccounts" class="list-group-item @(route == "/User/BankAccounts" ? "active" : "")">Cuentas Bancarias</a>
              


                    <a id="link-comercios" asp-page="/User/ActiveCommerce"
                       class="list-group-item @(route == "/User/ActiveCommerce" ? "active" : "")"
                       style="display:none;">Comercios Registrados</a>

                    <a id="link-bancos" asp-page="/User/ActiveBanks"
                       class="list-group-item @(route == "/User/ActiveBanks" ? "active" : "")"
                       style="display:none;">Bancos Registrados</a>

                   
                </div>
            </div>
            <div class="text-center py-3">
                <a asp-page="/Public/Index" class="logout-link">Cerrar Sesión</a>
            </div>
        </div>

        <!-- CONTENIDO -->
        <div id="page-content-wrapper" class="w-100">
            <main class="pt-4">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="custom-footer text-center py-3 border-top">
        <small class="text-muted">
            &copy; 2025 <strong>BilleTico</strong>. Todos los derechos reservados. &nbsp;–&nbsp;
            Desarrollado por el equipo <strong>CodeStream</strong>.
        </small>
    </footer>

@await RenderSectionAsync("Scripts", required: false)

    <script>
        const sidebar = document.getElementById('sidebarMenu');
        const toggleBtn = document.getElementById('sidebarToggle');

        toggleBtn.addEventListener('click', function () {
            sidebar.classList.toggle('show');
        });

        // Detecta clics fuera del sidebar y del botón para cerrarlo
        document.addEventListener('click', function (e) {
            const isClickInsideSidebar = sidebar.contains(e.target);
            const isClickToggleBtn = toggleBtn.contains(e.target);
            const isMobile = window.innerWidth <= 768;

            if (isMobile && !isClickInsideSidebar && !isClickToggleBtn && sidebar.classList.contains('show')) {
                sidebar.classList.remove('show');
            }
        });

        // Cerrar sesión: Swal + limpiar localStorage + redirigir
        document.querySelector(".logout-link")?.addEventListener("click", function (e) {
            e.preventDefault(); // Prevenir redirección automática

            Swal.fire({
                icon: "success",
                title: "Sesión cerrada",
                text: "Has cerrado sesión correctamente.",
                confirmButtonText: "OK"
            }).then(() => {
                localStorage.clear(); // Limpia el storage
                window.location.href = "/Public/Index"; // Redirige
            });
        });
    </script>


    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const user = JSON.parse(localStorage.getItem("user"));
            if (!user || !user.id) return;

            var ctrlActions = new ControlActions();

            // Mostrar "Comercios Registrados" si tiene rol en algún comercio
            ctrlActions.GetToApi(`FinalUserCommerceRol/RetrieveByUser?userId=${user.id}`, function (data) {
                if (data && data.length > 0) {
                    document.getElementById("link-comercios").style.display = "block";
                }
            });

            // Mostrar "Bancos Registrados" si tiene rol en alguna entidad financiera
            ctrlActions.GetToApi(`FinalUserFinancialEntityRol/RetrieveByUser?userId=${user.id}`, function (data) {
                if (data && data.length > 0) {
                    document.getElementById("link-bancos").style.display = "block";
                }
            });

        });
    </script>



</body>

</html>