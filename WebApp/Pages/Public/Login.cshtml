@page
@model WebApp.Pages.Public.LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
}

<style>
    .justify-content-center {
        justify-content: center !important;
        min-height: 70vh !important;
        margin-top: 9rem !important;
    }
</style>

<!-- HEADER personalizado -->
<header>
    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm fixed-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" asp-page="/Public/Index">
                <img src="~/img/logo-billetico.png" alt="Logo BilleTico" style="height: 40px;" />
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link fw-bold" asp-page="/Public/Index">Inicio</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold" asp-page="/Public/Register">Registrarse</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link text-success fw-bold" asp-page="/Public/Login">Iniciar Sesión</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<div class="container mt-5 pt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm rounded-4">
                <div class="card-body p-5">
                    <h2 class="text-center mb-4">Iniciar Sesión</h2>

                    <form id="frmLogin">
                        <div class="mb-3">
                            <label for="Email" class="form-label">Correo electrónico</label>
                            <input type="email" class="form-control" id="Email" name="email" ColumnDataName="email" required>
                        </div>

                        <div class="mb-3">
                            <label for="Password" class="form-label">Contraseña</label>
                            <input type="password" class="form-control" id="Password" name="password" ColumnDataName="password" required>
                        </div>

                        <div class="d-grid">
                            <button id="btnLogin" type="button" class="btn btn-primary">Iniciar sesión</button>
                        </div>

                    </form>

                    <div class="mt-3 text-center">
                        <a href="/Public/Register" class="link-secondary">¿No tienes cuenta? Regístrate</a>
                    </div>

                    <div class="mt-3 text-center">
                        <button id="btnToggleRecover" type="button" class="btn btn-link p-0">¿Olvidaste tu contraseña?</button>
                    </div>

                    <div id="recoverContainer" class="mt-3 d-none">
                        <hr class="my-3" />
                        <h5 class="mb-3 text-center">Recuperar contraseña</h5>
                        <form id="frmRecoverPassword" novalidate>
                            <div class="mb-3">
                                <label for="RecoverEmail" class="form-label">Correo electrónico</label>
                                <input type="email" class="form-control" id="RecoverEmail" name="email" placeholder="tu@correo.com" required>
                            </div>
                            <div class="d-grid">
                                <button id="btnRecoverPassword" type="button" class="btn btn-outline-primary">
                                    Recuperar contraseña
                                </button>
                            </div>
                        </form>
                    </div>


                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="~/js/pages/controlactions.js" asp-append-version="true"></script>
  <script src="~/js/pages/Login.js" asp-append-version="true"></script>
}
