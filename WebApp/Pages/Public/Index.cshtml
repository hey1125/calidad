@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<section id="inicio" class="hero-billetico text-white">
    <div class="hero-inner container-xl">
        <div class="row align-items-center">
            <!-- Texto -->
            <div class="col-lg-6 text-center text-lg-start mb-4 mb-lg-0">
                <h1 class="fw-bold display-4">¡Tu billetera digital<br />100% tica y segura!</h1>
                <p class="mt-3 mb-4 fs-5">
                    Desde tu celular o compu, pagá, administrá y aprovechá promociones en segundos.
                </p>
                <div class="d-flex gap-3 justify-content-center justify-content-lg-start">
                    <a href="/Public/Register" class="btn btn-warning fw-bold px-4 py-2">Registrate</a>
                    <a href="/Public/Login" class="btn btn-outline-light fw-bold px-4 py-2">Inicia Sesión</a>
                </div>
            </div>

            <!-- Imagen -->
            <div class="col-lg-6 text-center">
                <img src="~/img/hero-usuario.png" alt="Persona usando BilleTico" class="img-fluid hero-img" />
            </div>
        </div>
    </div>
</section>

<section id="beneficios" class="benefits-billetico py-5">
    <div class="container text-center">
        <h2 class="fw-bold mb-5">¿Por qué usar BilleTico?</h2>

        <div class="row g-4">
            <!-- Beneficio 1 -->
            <div class="col-md-6 col-lg-3">
                <div class="benefit-card p-3 h-100">
                    <img src="~/img/icono-seguridad.png" alt="Seguridad" class="benefit-icon mb-3" />
                    <h5 class="fw-bold">Seguridad</h5>
                    <p>Protección de tus datos y transacciones en todo momento.</p>
                </div>
            </div>

            <!-- Beneficio 2 -->
            <div class="col-md-6 col-lg-3">
                <div class="benefit-card p-3 h-100">
                    <img src="~/img/icono-facilidad.png" alt="Facilidad de uso" class="benefit-icon mb-3" />
                    <h5 class="fw-bold">Fácil de usar</h5>
                    <p>Diseñado para que cualquier persona lo entienda y lo use.</p>
                </div>
            </div>

            <!-- Beneficio 3 -->
            <div class="col-md-6 col-lg-3">
                <div class="benefit-card p-3 h-100">
                    <img src="~/img/icono-promociones.png" alt="Promociones" class="benefit-icon mb-3" />
                    <h5 class="fw-bold">Promociones</h5>
                    <p>Accedé a descuentos y beneficios exclusivos.</p>
                </div>
            </div>

            <!-- Beneficio 4 -->
            <div class="col-md-6 col-lg-3">
                <div class="benefit-card p-3 h-100">
                    <img src="~/img/icono-integracion.png" alt="Integración" class="benefit-icon mb-3" />
                    <h5 class="fw-bold">Integración</h5>
                    <p>Funciona con comercios y bancos de todo el país.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="comercios" class="hero-billetico text-white">
    <div class="hero-inner container-xl">
        <div class="row align-items-center">
            <!-- Texto -->
            <div class="col-lg-6 text-center text-lg-start mb-4 mb-lg-0">
                <h2 class="fw-bold mb-3">
                    ¿Sos <span class="text-warning">comercio</span> o <span class="text-warning">entidad financiera</span>?
                </h2>
                <p class="fs-5 mb-4">Administrá tu operación desde BilleTico.</p>
                <a href="/Public/Register" class="btn btn-warning fw-bold px-4 py-2">Comenzá ahora</a>
            </div>
            <br />

            <!-- Imagen -->
            <div class="col-lg-6 text-center">
                <img src="~/img/comercio-entidad.png" alt="Mujer usando tablet" class="img-fluid comercio-img" />
            </div>
        </div>
    </div>
</section>

<section id="confianza" class="confianza-billetico py-5">
    <div class="container text-center">
        <h2 class="fw-bold mb-5">
            Comercios y entidades financieras que <span class="text-success">confían</span> en BilleTico
        </h2>

        <div class="row g-4">

            <div class="col-6 col-md-4 col-lg-3">
                <img src="~/img/logo-bcr.png" alt="BCR" class="logo-aliado img-fluid" />
            </div>
            <div class="col-6 col-md-4 col-lg-3">
                <img src="~/img/logo-bancopopular.png" alt="Banco Popular" class="logo-aliado img-fluid" />
            </div>
            <div class="col-6 col-md-4 col-lg-3">
                <img src="~/img/logo-pmundo.png" alt="Pequeño Mundo" class="logo-aliado img-fluid" />
            </div>

            <div class="col-6 col-md-4 col-lg-3">
                <img src="~/img/logo-bekono.png" alt="Ekono" class="logo-aliado img-fluid" />
            </div>
            
        </div>

    </div>
</section>
